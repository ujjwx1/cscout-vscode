{
  // TODO: indentation is inconsistent across this project right now.
  // cscoutClient.ts, lifecycle.ts, platform.ts and buildSystem.ts use
  // tabs, but extension.ts and the test files use spaces. Fix this with
  // Prettier: pick tabs or spaces for the whole project, add a
  // .prettierrc, run it once to reformat everything, then add a
  // format:check script and wire it into CI next to the existing lint
  // step, same idea as npm run lint.
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2020",
    "outDir": "out",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "lib": ["ES2020"]
  },
  "exclude": ["node_modules", "out"]
}
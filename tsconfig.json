{
  // TODO: indentation is inconsistent across this project right now.
  // cscoutClient.ts, lifecycle.ts, platform.ts and buildSystem.ts use
  // tabs, but extension.ts and test.ts use spaces. Leaving this alone for
  // now since it's a solo project and it isn't causing any real problems,
  // but if more people start working on this, pick one style, re-indent
  // whichever files don't match, and maybe add an .editorconfig so it
  // stays consistent going forward.
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2020",
    "outDir": "out",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "lib": ["ES2020"]
  },
  "exclude": ["node_modules", "out"]
}